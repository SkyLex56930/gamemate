{
  "expo": {
    "name": "GameMate",
    "slug": "gamemate",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/gamemate-mark-transparent.png",
    "userInterfaceStyle": "dark",
    "plugins": [
      "expo-notifications",
      [
        "@config-plugins/react-native-webrtc",
        {
          "microphonePermission": "GameMate utilise le microphone quand tu rejoins un salon vocal.",
          "cameraPermission": "GameMate utilise la caméra pendant les appels vidéo."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#020615",
          "image": "./assets/gamemate-logo-transparent.png",
          "imageWidth": 260,
          "resizeMode": "contain"
        }
      ],
      "expo-font",
      [
        "expo-audio",
        {
          "microphonePermission": "GameMate utilise le microphone pour les appels et les messages vocaux.",
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      "expo-asset"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.skylex.gamemate",
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#020615",
        "foregroundImage": "./assets/gamemate-mark-transparent.png"
      },
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false,
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/gamemate-mark-transparent.png"
    },
    "extra": {
      "eas": {
        "projectId": "2c9eaecd-8d93-41bb-bc55-3f98f66285df"
      }
    },
    "owner": "skylexofffr"
  }
}
